# Cloud sync (optional). Leave unset and the app runs exactly as before:
# localStorage only, no account UI, no backend required.
#
# Both values come from the Supabase dashboard under Project Settings > API.
# The anon key is meant to ship in the client bundle — row-level security is
# what protects the data. Never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
